{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hear-our-language.local/prompts/stage07/facts.schema.json",
  "title": "Stage07LessonPageFacts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topic",
    "source_text",
    "source_text_complete",
    "language_segments",
    "vocabulary",
    "scene",
    "visual_elements",
    "original_activity",
    "answer_evidence",
    "question_type",
    "quality_warnings",
    "confidence"
  ],
  "properties": {
    "schema_version": { "const": "stage07-facts.v3" },
    "topic": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source_text": {
      "type": "string",
      "minLength": 1,
      "description": "Verbatim observable textbook text in page reading order; preserve only what is visible and do not summarize or fill unclear text."
    },
    "source_text_complete": {
      "type": "boolean",
      "description": "True only when the visible lesson text has a readable beginning and end with no crop, occlusion, glare, or unreadable continuation; false is valid for a partial, non-lesson, or review-required page."
    },
    "language_segments": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered MI300 labels for source_text. Concatenating content after whitespace normalization must equal source_text exactly. Do not generate Tailo or POJ here.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lang", "content"],
        "properties": {
          "lang": { "type": "string", "enum": ["zh-TW", "nan-TW"] },
          "content": { "type": "string", "minLength": 1 }
        }
      }
    },
    "vocabulary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hanji", "tailo", "meaning"],
        "properties": {
          "hanji": { "type": "string", "minLength": 1 },
          "tailo": { "type": ["string", "null"] },
          "meaning": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scene": { "type": "string", "minLength": 1 },
    "visual_elements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "original_activity": { "type": "string", "minLength": 1 },
    "answer_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "question_type": {
      "type": "string",
      "enum": ["visual_question", "dialogue", "reading", "matching", "none"]
    },
    "quality_warnings": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
