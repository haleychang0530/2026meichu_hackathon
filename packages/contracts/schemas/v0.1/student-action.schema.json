{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hear-our-language.local/contracts/v0.1/student-action.schema.json",
  "title": "StudentActionResult",
  "description": "Student-safe response after a session control action. Answer submission uses $defs/answer_submission and the turns endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "session_id",
    "lesson_id",
    "state",
    "progress",
    "current_prompt",
    "action",
    "feedback",
    "next_prompt",
    "can_answer",
    "phase",
    "revision",
    "last_event_id"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "session_id": { "type": "string", "pattern": "^session_[A-Za-z0-9_-]+$" },
    "lesson_id": { "type": "string", "pattern": "^lesson_[A-Za-z0-9_-]+$" },
    "state": { "$ref": "#/$defs/session_state" },
    "progress": { "type": "number", "minimum": 0, "maximum": 1 },
    "current_prompt": { "type": ["string", "null"] },
    "current_utterance": {
      "anyOf": [
        { "$ref": "#/$defs/utterance" },
        { "type": "null" }
      ]
    },
    "action": { "$ref": "#/$defs/action" },
    "feedback": { "type": ["string", "null"] },
    "next_prompt": { "type": ["string", "null"] },
    "feedback_utterance": {
      "anyOf": [
        { "$ref": "#/$defs/utterance" },
        { "type": "null" }
      ]
    },
    "next_utterance": {
      "anyOf": [
        { "$ref": "#/$defs/utterance" },
        { "type": "null" }
      ]
    },
    "can_answer": { "type": "boolean" },
    "phase": { "$ref": "#/$defs/teaching_phase" },
    "revision": { "type": "integer", "minimum": 0 },
    "last_event_id": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": ["replay_prompt", "start_answer", "pause", "resume", "request_hint", "next"]
    },
    "input_mode": {
      "type": "string",
      "enum": ["voice", "keyboard", "pointer"]
    },
    "session_state": {
      "type": "string",
      "enum": ["IDLE", "SPEAKING", "LISTENING", "TRANSCRIBING", "EVALUATING", "RECOVERABLE_ERROR", "COMPLETE"]
    },
    "control_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "action"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "action": { "$ref": "#/$defs/action" },
        "input_mode": { "$ref": "#/$defs/input_mode" },
        "expected_revision": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "answer_submission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transcript"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "transcript": { "type": "string", "minLength": 1 },
        "input_mode": { "$ref": "#/$defs/input_mode" },
        "asr_device": { "type": "string", "enum": ["npu", "cpu"] },
        "expected_revision": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "teaching_phase": {
      "type": "string",
      "enum": ["introduction", "demonstration", "read_aloud", "comprehension", "hint", "review", "complete"]
    },
    "utterance_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lang", "hanji", "tailo_citation", "poj_citation", "zh_gloss", "source", "pronunciation_status"],
      "properties": {
        "lang": { "type": "string", "enum": ["nan-TW", "zh-TW"] },
        "hanji": { "type": "string", "minLength": 1 },
        "tailo_citation": { "type": ["string", "null"] },
        "poj_citation": { "type": ["string", "null"] },
        "zh_gloss": { "type": ["string", "null"] },
        "source": { "type": "string", "enum": ["textbook", "dictionary", "generated"] },
        "pronunciation_status": { "type": "string", "enum": ["verified", "converted", "needs_review"] }
      }
    },
    "utterance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "segments", "tts_provider", "audio_url", "audio_cache_key"],
      "properties": {
        "schema_version": { "const": "0.1.0" },
        "id": { "type": "string", "pattern": "^utt_[A-Za-z0-9_-]+$" },
        "segments": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/utterance_segment" } },
        "tts_provider": { "type": ["string", "null"], "enum": ["mms-tts-nan", "windows", "prerecorded", null] },
        "audio_url": { "type": ["string", "null"], "format": "uri-reference" },
        "audio_cache_key": { "type": ["string", "null"] }
      }
    }
  }
}
